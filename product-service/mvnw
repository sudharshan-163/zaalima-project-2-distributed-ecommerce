#!/bin/sh
set -e

BASE_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
MAVEN_VERSION="3.9.15"
MAVEN_HOME="$BASE_DIR/.maven/apache-maven-$MAVEN_VERSION"
MAVEN_ZIP="$BASE_DIR/.maven/apache-maven-$MAVEN_VERSION-bin.zip"

if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  mkdir -p "$BASE_DIR/.maven"
  if [ ! -f "$MAVEN_ZIP" ]; then
    echo "Downloading Apache Maven $MAVEN_VERSION..."
    curl -fsSL "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.zip" -o "$MAVEN_ZIP"
  fi
  unzip -q -o "$MAVEN_ZIP" -d "$BASE_DIR/.maven"
fi

exec "$MAVEN_HOME/bin/mvn" "$@"
